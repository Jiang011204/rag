# ===== 中转站（OpenAI 协议）=====
GATEWAY_BASE_URL=https://your-gateway/v1
GATEWAY_API_KEY=sk-xxx

# ===== 模型路由（function -> model，可随时切换）=====
# 依据 https://ai.amaxsmp.com/v1/models 实际可用模型：
MODEL_EMBEDDING=text-embedding-v4
MODEL_EXTRACT=gpt-4o-mini
MODEL_GENERATE=deepseek-v4-pro        # 带 reasoning_content 的思维链模型
MODEL_DIAGNOSE=deepseek-v4-pro

# 思维链字段：auto（自动探测）| reasoning_content（强制）| none（关闭思维链）
REASONING_FIELD=auto

# ===== 应用自身 API Key（外部调用 /v1/* 时用，与中转站 key 分离）=====
APP_API_KEY=kb-xxx

# ===== Neo4j =====
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=please-change-me

# ===== 数据目录（LanceDB + SQLite）=====
DATA_DIR=./data
